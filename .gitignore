__pycache__/
*.pyc
.vscode/
logs/
*.log
.apptainer/
.npm/
.local/
*.db
*.db-shm
*.db-wal
run_dir/
output/
# Shared scratch for cluster jobs — created by the launcher on a scheduler host,
# and the one path that means the same thing in the container, on the host and
# on a compute node. Run data, never config.
cluster_runs/
*.sif
*.img
config.env
claude_config/
**/claude_config/
# Only the REPO-ROOT .claude/ is local session state. Agent configs deeper in the
# tree ARE the deliverable — the frozen ones under legacy/, and the preset trees of
# the current release — so this is anchored with a leading slash rather than
# matching a directory named .claude at any depth.
/.claude/
legacy/madagents_v2/claude_code/.config/
legacy/madagents_v2/claude_code/archive
# Claude Code auth / config files — never commit, at any depth. Kept after the
# rule above so a stray auth file inside a tracked .claude/ tree is still ignored.
.credentials.json
**/.credentials.json
**/.claude.json
# A committed agent config includes its settings.local.json. Negate here so this
# survives a global ignore of that filename (~/.config/git/ignore); the root
# .claude/ is unaffected, since git will not descend into an excluded directory.
!**/.claude/settings.local.json
# --- opencode -----------------------------------------------------------------
# opencode is NOT vendored here: the user installs it (a single binary from the
# upstream release), or the container does. Nothing below is ever committed.
#
# Only the REPO-ROOT .opencode/ is local session state — a generated system tree
# under madagents_opencode/.opencode/ IS the deliverable, so this is anchored
# with a leading slash for exactly the reason /.claude/ above is.
/.opencode/
# An install prefix, if anyone ever points one inside the checkout. The binary
# is ~171 MB and belongs on the machine, not in git.
opencode_bin/
**/opencode_bin/
# opencode's own XDG roots, should one ever be pointed into the repo: the data
# root holds auth.json and session history, the cache root holds the models.dev
# catalogue and downloaded helper binaries.
opencode_config/
**/opencode_config/
opencode_cache/
**/opencode_cache/
# opencode credentials at any depth — the data root's auth.json is a real
# credential file, like .credentials.json above.
**/auth.json
# The per-launch bearer-token file the local launcher writes for a self-hosted
# endpoint (referenced from opencode.json as {file:...}, never inlined). It is
# written into the run workdir under the already-ignored run_dir/; this rule is
# belt-and-braces in case that ever moves.
opencode-token
**/opencode-token

.nfs*
archive/
.apptainer_tmp
