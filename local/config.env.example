# Copy to local/config.env and fill in. Read only by local/madrun.sh — the
# repo-root ./madrun.sh ignores this file entirely.
#
# Precedence: caller env > local/config.env > defaults, so any value here can
# be overridden for a single run:
#   LOCAL_MODEL_NAME=my-other-model ./local/madrun.sh
#
# local/config.env is git-ignored. Treat it like a password file: the token
# below is a real credential for your endpoint.

# The endpoint, speaking the Anthropic /v1/messages API. Required — without it
# local/madrun.sh refuses to start rather than silently falling back to
# Anthropic's hosted API.
#   e.g. http://my-gpu-node:8000
LOCAL_MODEL_BASE_URL=""

# Bearer token your endpoint expects. Leave empty if it does not authenticate
# (a server on a trusted network, an SSH tunnel to localhost, ...).
LOCAL_MODEL_TOKEN=""

# Model name to request, passed to claude as --model. Leave empty to let Claude
# Code send its default name — correct only if your endpoint ignores the field
# or happens to serve that name.
#   e.g. qwen3-32b
LOCAL_MODEL_NAME=""

# Reasoning effort, passed as --effort: low | medium | high | xhigh | max.
# Leave empty to omit the flag. Endpoints that do not implement it may reject
# the request, so start empty and add it only if yours supports it.
LOCAL_MODEL_EFFORT=""

# NOTE: do not set ANTHROPIC_BASE_URL or ANTHROPIC_AUTH_TOKEN here or in your
# shell. The main launcher scrubs those names unconditionally, so using them
# would be silently ineffective for a normal run and confusing for this one.
# The rename happens inside this launcher, at the moment the session starts.
