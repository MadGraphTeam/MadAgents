# Copy to local/config.env and fill in. Read only by local/madrun.sh — the
# repo-root ./madrun.sh ignores this file entirely.
#
# Precedence: caller env > local/config.env > defaults, so any value here can
# be overridden for a single run:
#   LOCAL_MODEL_NAME=my-other-model ./local/madrun.sh
#
# local/config.env is git-ignored. Treat it like a password file: the token
# below is a real credential for your endpoint.

# Which CLI a new local run is built for: opencode (default) or claude_code.
# They want DIFFERENT endpoints, so this decides what LOCAL_MODEL_BASE_URL below
# must point at:
#
#   opencode     — any OpenAI-compatible endpoint (/v1/chat/completions). The
#                  endpoint and its key are written into a config FILE the
#                  launcher generates per run, so nothing credential-shaped ever
#                  enters the container environment.
#   claude_code  — an endpoint speaking the Anthropic /v1/messages API,
#                  including tool use. Reached by setting ANTHROPIC_BASE_URL in
#                  the container, which is why that path exists as a separate
#                  launcher at all.
#
# An existing run keeps whatever it was built with; this only affects new ones.
LOCAL_PROVIDER="opencode"

# The endpoint. Required — without it local/madrun.sh refuses to start rather
# than silently falling back to a hosted API.
#   opencode:    include the /v1 suffix, e.g. http://my-gpu-node:8000/v1
#   claude_code: e.g. http://my-gpu-node:8000
LOCAL_MODEL_BASE_URL=""

# Bearer token your endpoint expects. Leave empty if it does not authenticate
# (a server on a trusted network, an SSH tunnel to localhost, ...).
LOCAL_MODEL_TOKEN=""

# Model name to request.
#   opencode:    the id your server returns from GET /v1/models. It becomes the
#                session default, addressed as local/<name>. Strongly recommended
#                — without it the provider declares no models and you must pick
#                one in the TUI.
#   claude_code: passed as --model. Leave empty to let Claude Code send its own
#                default name, correct only if your endpoint ignores the field.
#   e.g. qwen3-32b
LOCAL_MODEL_NAME=""

# NOTE: where opencode itself lives, and where its config/cache/session roots
# live, are NOT set here — they belong beside APPTAINER_DIR in the repo-root
# config.env, which this launcher also reads:
#
#   OPENCODE_DIR   the directory containing the `opencode` binary
#   OPENCODE_HOME  one directory holding opencode's four XDG roots
#
# This file is only about the endpoint: which model, where, and with what
# credential.

# Reasoning effort, passed as --effort: low | medium | high | xhigh | max.
# Leave empty to omit the flag. Endpoints that do not implement it may reject
# the request, so start empty and add it only if yours supports it.
LOCAL_MODEL_EFFORT=""

# NOTE: do not set ANTHROPIC_BASE_URL or ANTHROPIC_AUTH_TOKEN here or in your
# shell. The main launcher scrubs those names unconditionally, so using them
# would be silently ineffective for a normal run and confusing for this one.
# The rename happens inside this launcher, at the moment the session starts.
